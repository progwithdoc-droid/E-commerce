# Neon / PostgreSQL (pooled — used by Prisma & app)
# Pooled URL — use sslmode=require&connect_timeout=30 (omit channel_binding on Windows)
DATABASE_URL=
# Unpooled — optional, for `prisma migrate` on Neon
DATABASE_URL_UNPOOLED=

# Auth (NextAuth.js v5)
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Admin sign-up access code (required for /admin/register)
ADMIN_SETUP_SECRET=

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Email
RESEND_API_KEY=

# Uploads (UploadThing)
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=
UPLOADTHING_TOKEN=

# Email from address (optional, Resend verified domain)
RESEND_FROM_EMAIL=Aurum Store <onboarding@resend.dev>
